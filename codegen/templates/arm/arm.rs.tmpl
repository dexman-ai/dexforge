#[cfg(test)]
mod tests {
    use super::*;
    use dexhal::math::DEFAULT_TOLERANCE_POLICY;

    /// Deterministic joint vectors inside the joint limits.
    fn sample(k: usize) -> [f64; DOF] {
        core::array::from_fn(|i| {
            let (lo, hi) = match {{struct_name}}::JOINT_LIMITS[i] {
                Some((lo, hi)) => (lo.max(-core::f64::consts::PI), hi.min(core::f64::consts::PI)),
                None => (-core::f64::consts::PI, core::f64::consts::PI),
            };
            let u = ((k * 7 + i * 13) % 17) as f64 / 17.0;
            lo + 0.1 * (hi - lo) + 0.8 * (hi - lo) * u
        })
    }

    #[test]
    fn nominal_chain_matches_generated_kinematics() {
        let chain = nominal_chain();
        for k in 0..16 {
            let q = sample(k);
            let fk = {{struct_name}}::flange_fk(&q);
            assert!((chain.fk(&q) - fk).norm() < 1e-9, "fk mismatch at {q:?}");
            let jac = {{struct_name}}::flange_jacobian(&q);
            let chain_jac = chain.jacobian(&q);
            for r in 0..6 {
                for c in 0..DOF {
                    assert!(libm::fabs(jac[r][c] - chain_jac[r][c]) < 1e-9, "jacobian mismatch at {q:?}");
                }
            }
        }
    }

    #[test]
    fn flange_all_closes_on_fk_targets() {
        for k in 0..16 {
            let q = sample(k);
            let target = {{struct_name}}::flange_fk(&q);
            let sols = {{struct_name}}::flange_all(
                &target,
                Some(&q),
                true,
                false,
                DEFAULT_TOLERANCE_POLICY,
                15,
            );
            let first = sols[0].expect("a reachable in-limit target has a solution");
            assert!(({{struct_name}}::flange_fk(&first) - target).norm() < 1e-5);
            for sol in sols.iter().flatten() {
                assert!(({{struct_name}}::flange_fk(sol) - target).norm() < 1e-5);
            }
        }
    }
{{#six_dof}}

    #[test]
    fn flange_one_fast_closes_and_respects_limits() {
        for k in 0..16 {
            let q = sample(k);
            let target = {{struct_name}}::flange_fk(&q);
            let got = {{struct_name}}::flange_one(&target, &q, IkKind::Fast, DEFAULT_TOLERANCE_POLICY, 15)
                .expect("a reachable in-limit target has a solution");
            assert!(({{struct_name}}::flange_fk(&got) - target).norm() < 1e-5);
            assert!(dexhal::math::postprocess::within_limits(&got, &{{struct_name}}::JOINT_LIMITS));
        }
    }

    #[test]
    fn flange_one_near_matches_nearest_of_full_set() {
        let policy = DEFAULT_TOLERANCE_POLICY;
        for k in 0..16 {
            let q = sample(k);
            let target = {{struct_name}}::flange_fk(&q);
            for off in [-0.4, -0.1, 0.05, 0.3] {
                let seed: [f64; DOF] = core::array::from_fn(|i| q[i] + if i % 2 == 0 { off } else { -off });
                let single = {{struct_name}}::flange_one(&target, &seed, IkKind::Near, policy, 15);
                let full = {{struct_name}}::flange_all(&target, Some(&seed), true, true, policy, 15);
                // Near returns the nearest solution that passes the per-joint step gate.
                let expected = full
                    .iter()
                    .flatten()
                    .find(|b| dexhal::math::single::within_max_joint_step(b, &seed));
                match (single, expected) {
                    (Some(a), Some(b)) => {
                        assert!(({{struct_name}}::flange_fk(&a) - target).norm() < 1e-5);
                        assert!(
                            (0..DOF).all(|i| libm::fabs(libm::remainder(a[i] - b[i], core::f64::consts::TAU)) < 1e-2),
                            "single {a:?} != nearest gated {b:?}"
                        );
                    }
                    (None, None) => {}
                    _ => panic!("single/full disagree on existence: {single:?} vs {expected:?}"),
                }
            }
        }
    }
{{/six_dof}}
