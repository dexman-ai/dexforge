/// The nominal kinematic chain from the `ssik` artifact, e.g. as the starting
/// point of `dexhal::math::identify` or for a vendor calibration.
pub fn nominal_chain() -> KinematicChain<DOF> {
    let joints: [ChainJoint; DOF] = core::array::from_fn(|i| ChainJoint {
        origin: Pose::from_row_slice(&JOINT_ORIGINS[i]),
        axis: JOINT_AXES[i],
        offset: 0.0,
    });
    KinematicChain::new(&joints, &Pose::from_row_slice(&FLANGE))
        .expect("nominal chain from the ssik artifact is rigid")
}

