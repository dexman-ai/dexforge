    #[test]
    fn flange_one_closes_and_near_returns_seed_configuration() {
        for k in 0..16 {
            let q = sample(k);
            let target = {{struct_name}}::flange_fk(&q);
            let fast = {{struct_name}}::flange_one(&target, &q, IkKind::Fast, DEFAULT_TOLERANCE_POLICY, 15)
