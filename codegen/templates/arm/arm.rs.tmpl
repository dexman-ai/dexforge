    #[allow(clippy::approx_constant)] // URDF limits are rounded literals (3.14, 6.2832), not PI/TAU.
    const JOINT_LIMITS: [JointLimit; DOF] = [
{{joint_limits}}    ];
    const HAS_DYNAMICS: bool = {{has_dynamics}};
{{#seven_dof}}
