                .expect("the seed is itself a root");
            assert!(({{struct_name}}::flange_fk(&near) - target).norm() < 1e-5);
            for i in 0..DOF {
                assert!(libm::fabs(near[i] - q[i]) < 1e-5, "Near drifted from seed at joint {i}");
            }
